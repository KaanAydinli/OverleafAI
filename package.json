{
  "name": "overleaf-ai-reviewer",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "install:browsers": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "postinstall": "npm run install:browsers",
    "save-session": "PLAYWRIGHT_BROWSERS_PATH=0 tsx src/cli/saveSession.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "playwright": "^1.58.2"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
